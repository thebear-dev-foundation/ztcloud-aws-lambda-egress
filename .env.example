# Zscaler OneAPI credentials — source locally for deploy scripts.
# Copy to .env and populate. Never commit .env.

# ZIdentity vanity domain — format: z-<orgid>.zslogin.net
export ZS_VANITY_DOMAIN=z-XXXXXXXX.zslogin.net
export ZS_CLIENT_ID=your-client-id-here
export ZS_CLIENT_SECRET=your-client-secret-here

# AWS region for deployment
export AWS_REGION=ap-southeast-2

# SFTP test target (pick ONE approach):
#   - Internet SFTP server: public FQDN/IP the Lambda will SFTP to
#   - Internal SFTP server: resolve via ZPA (not covered in this module v0.1)
export SFTP_HOST=sftp.example.com
export SFTP_PORT=22
export SFTP_USER=your-sftp-username
# SFTP password OR private-key path — NEVER commit secrets; wire through Secrets Manager in prod
export SFTP_PASSWORD=your-sftp-password
